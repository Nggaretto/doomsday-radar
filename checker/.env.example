# انسخ الملف ده باسم .env وعدّل اللي محتاجه
SITE_URL=https://tanta.galaxy-cinema.com/
POLL_SECONDS=30

# لو الموقع بيحمّل المحتوى بجافاسكريبت (الصفحة بتبان فاضية للبوت) خليها true وركّب playwright
USE_BROWSER=false

# بيانات حسابك على موقع جلاكسي (للحجز الأوتوماتيك) — بتفضل على جهازك بس
AUTO_BOOK=true
LOGIN_URL=
LOGIN_USER=
LOGIN_PASS=

# مفتاح Firebase Admin: ملف JSON في نفس الفولدر بإسم serviceAccountKey.json
# أو حط محتواه كله في السطر ده (للـ GitHub Actions)
# FIREBASE_SERVICE_ACCOUNT=

# تعديلات متقدمة (سيبها لو مش محتاج)
# SEAT_SELECTOR=.seat
# REVERSE_ROWS=false
# IDEAL_ROW=0.6
